{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sample",
  "description": "One telemetry sample: a channel value with the device's clock.",
  "type": "object",
  "required": [
    "channel",
    "device",
    "t",
    "value"
  ],
  "properties": {
    "channel": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "t": {
      "description": "Device-local monotonic time (seconds). TICK_monotonicity holds here: the device clock only advances.",
      "type": "number",
      "format": "double"
    },
    "value": {
      "$ref": "#/definitions/MhsValue"
    }
  },
  "definitions": {
    "MhsValue": {
      "description": "A scalar value crossing the MHS boundary. Deliberately tiny: the press surface is \"read\" (get temperature) / \"write\" (set temperature) style primitives, so scalars plus null cover the announced shape without inventing container semantics.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Null"
          ]
        },
        {
          "type": "object",
          "required": [
            "Bool"
          ],
          "properties": {
            "Bool": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Int"
          ],
          "properties": {
            "Int": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Float"
          ],
          "properties": {
            "Float": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Str"
          ],
          "properties": {
            "Str": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
